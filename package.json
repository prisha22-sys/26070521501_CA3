{
  "name": "keeploop",
  "version": "1.0.0",
  "description": "KeepLoop - Personal Asset, Warranty & Maintenance Lifecycle Management System",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "keeploop",
    "asset-management",
    "warranty-tracker",
    "maintenance-tracker",
    "mongodb-atlas",
    "react",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC"
}


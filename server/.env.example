# ====================================================================
# KeepLoop Server Environment Configuration
# Copy this file to .env and fill in your MongoDB Atlas details.
# DO NOT commit your actual .env file to Git!
# ====================================================================

# Port for Express server
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# ====================================================================
# MONGODB ATLAS CONNECTION STRING:
# 1. Sign up/Log in at https://cloud.mongodb.com/
# 2. Create a free M0 Cluster (Shared).
# 3. Create a Database User with username & password in "Database Access".
# 4. Whitelist your IP (or 0.0.0.0/0 to allow access from anywhere) in "Network Access".
# 5. Click "Connect" -> "Drivers" -> Choose "Node.js".
# 6. Copy the connection string and replace <db_password> with your user's password.
#    IMPORTANT: If your password contains special characters (like @, #, $, %, etc.),
#    you MUST URL-encode them (e.g. '@' becomes '%40', '#' becomes '%23').
# 7. Append the database name before the query string, e.g. /keeploop?retryWrites=true&w=majority
# ====================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxxxxx.mongodb.net/keeploop?retryWrites=true&w=majority

# Secret key used to sign and verify JWT authentication tokens
# You can generate a random string or use any secure 32+ character passphrase
JWT_SECRET=keeploop_super_secret_jwt_key_replace_in_production_2026

# JWT token expiration time (e.g., 7d, 24h, 30d)
JWT_EXPIRE=7d

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173


# ====================================================================
# KeepLoop Git Ignore Configuration
# ====================================================================

# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
client/dist/
build/
*.tsbuildinfo

# Sensitive Environment Configurations (NEVER COMMIT CREDENTIALS)
.env
.env.*
*.env
*.env.local
server/.env
server/.env.*
server/*.env

# Preserve example configuration templates
!.env.example
!server/.env.example

# Logs and runtime diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# IDE, OS & System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Temporary and scratch files
test_*.js
*.tmp
*.temp
